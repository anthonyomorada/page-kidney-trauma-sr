  pages = {737.e1-737.e9},
  issn = {14775131},
  doi = {10.1016/j.jpurol.2021.06.026},
  urldate = {2025-06-29},
  abstract = {Purpose Children have a greater chance of sustaining a renal injury than adults and higher odds of having a highgrade renal injury. Hypertension is a rare complication of blunt renal trauma, with risk being higher in cases of major renal trauma. We reviewed the cases of pediatric blunt renal trauma-induced hypertension in our tertiary referral center in an attempt to better understand this rare condition.},
