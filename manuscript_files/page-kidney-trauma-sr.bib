  issn = {22132945},
  doi = {10.1016/j.jasc.2017.06.122},
  abstract = {Introduction: Fine needle aspiration (FNA) of superficial and deep seated lesions has been used with high sensitivity and specificity in the diagnosis of neoplastic and non-neoplastic lesions. However, literature of FNA in post-transplant patients is sparse. We undertook a retrospective study to evaluate the utility of FNA in the clinical management of post liver transplant patients.},
