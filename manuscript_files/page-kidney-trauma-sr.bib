  shorttitle = {Blunt Renal Trauma-Induced Hypertension in Pediatric Patients},
  author = {Marcou, Marios and Galiano, Matthias and J{\"u}ngert, J{\"o}rg and Rompel, Oliver and Kuwert, Torsten and Wullich, Bernd and {Hirsch-Koch}, Karin},
  year = {2021},
